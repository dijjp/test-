/* styles.css */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    padding: 0;
}

.navbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background-color: #333;
    color: white;
    padding: 10px 20px;
}

.menu {
    list-style: none;
    display: flex;
}

.menu li a {
    text-decoration: none;
    color: white;
    margin-right: 20px;
}

.hero {
    background-color: #f4f4f4;
    padding: 50px 0;
    text-align: center;
}

.hero h1, .hero p {
    font-size: 2em;
    color: #333;
}

.product {
    display: inline-block;
    margin: 20px;
    border: 1px solid #ddd;
    padding: 10px;
    text-align: center;
}

.add-to-cart {
    display: block;
    width: 100%;
    padding: 10px;
    background-color: #333;
    color: white;
    text-decoration: none;
}

footer {
    background-color: #333;
    color: white;
    text-align: center;
    padding: 10px 0;
}
